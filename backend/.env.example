PORT=5000

# Option 1 (Render): a single PostgreSQL connection string.
# Render injects this automatically when the database is linked.
# DATABASE_URL=postgresql://user:password@host:5432/jru_alumni_db
# Render PostgreSQL requires TLS. Default: on when DATABASE_URL is set.
# DB_SSL=true

# Option 2 (local): individual PostgreSQL settings.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-your-local-postgres-password
PGDATABASE=jru_alumni_db

# Admin portal passcode (Alt+A opens the admin sign-in modal)
ADMIN_PIN=1234
ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Optional: comma-separated list of allowed frontend origins. Leave empty to allow all.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
